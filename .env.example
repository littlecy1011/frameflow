# Leave blank to use the included demo-vault.
AI_VIDEO_VAULT_ROOT=

# Leave blank to auto-detect Codex CLI.
AI_VIDEO_CODEX_BIN=

# Optional: use your own Hypit installation. The built-in director method works without it.
AI_VIDEO_HYPIT_SKILL=
AI_VIDEO_HYPIT_BIN=

AI_VIDEO_SCAN_SECONDS=5
AI_VIDEO_CODEX_TIMEOUT=900
